<!DOCTYPE html>
<html>
<head>
    <title>WEB API CALCULADORA</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background: #f5f5f5;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        h1 {
            color: #333;
            text-align: center;
        }

        .btn-group {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin: 20px 0;
        }

        button {
            padding: 12px;
            background: #007cba;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

            button:hover {
                background: #005a87;
            }

        .result {
            margin-top: 20px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 5px;
            border-left: 4px solid #007cba;
        }

        .loading {
            color: #666;
            font-style: italic;
        }

        .error {
            background: #ffe6e6;
            border-left-color: #ff0000;
        }

        .success {
            background: #e6ffe6;
            border-left-color: #00cc00;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🧮 WEB API CALCULADORA</h1>

        <div class="btn-group">
            <button onclick="callApi('TodosLosCalculos')">📊 Todos los Cálculos</button>
            <button onclick="callApi('Sumas')">➕ Sumas</button>
            <button onclick="callApi('Restas')">➖ Restas</button>
            <button onclick="callApi('Multiplicaciones')">✖️ Multiplicaciones</button>
            <button onclick="callApi('Divisiones')">➗ Divisiones</button>
            <button onclick="callApi('CalculosRecientes')">🕒 Cálculos Recientes</button>
            <button onclick="callApi('TestConnection')">🔗 Test Conexión</button>
        </div>

        <div id="result" class="result">
            👆 Haz click en un botón para ver los resultados
        </div>
    </div>

    <script>
        async function callApi(endpoint) {
            const resultDiv = document.getElementById('result');
            resultDiv.innerHTML = '<div class="loading">⏳ Cargando...</div>';

            try {
                const response = await fetch(`/api/Calculadora/${endpoint}`);
                const data = await response.json();

                if (data.result === 1) {
                    resultDiv.className = 'result success';
                    resultDiv.innerHTML = `
                            <h3>✅ ${data.message}</h3>
                            <pre>${JSON.stringify(data.data, null, 2)}</pre>
                        `;
                } else {
                    resultDiv.className = 'result error';
                    resultDiv.innerHTML = `
                            <h3>❌ Error</h3>
                            <p>${data.message}</p>
                        `;
                }
            } catch (error) {
                resultDiv.className = 'result error';
                resultDiv.innerHTML = `
                        <h3>❌ Error de conexión</h3>
                        <p>${error.message}</p>
                        <p>Verifica que el API esté ejecutándose</p>
                    `;
            }
        }
    </script>
</body>
</html>